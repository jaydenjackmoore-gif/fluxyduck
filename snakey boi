<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Multiplayer Snake Game</title>
<style>
  body {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #111;
    color: #fff;
    font-family: Arial, sans-serif;
    height: 100vh;
    margin: 0;
  }
  #scoreboard {
    margin: 10px;
    font-size: 20px;
  }
  canvas {
    background: #222;
    border: 2px solid #555;
  }
</style>
</head>
<body>
<div id="scoreboard">Player 1: 0 | Player 2: 0</div>
<canvas id="gameCanvas" width="400" height="400"></canvas>
<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const box = 20;

let snake1 = [{ x: 5 * box, y: 5 * box }];
let snake2 = [{ x: 15 * box, y: 15 * box }];
let dir1 = 'RIGHT';
let dir2 = 'LEFT';
let food = { x: Math.floor(Math.random() * 20) * box, y: Math.floor(Math.random() * 20) * box };
let score1 = 0;
let score2 = 0;
let speed = 150;

document.addEventListener('keydown', function(e){
  const key = e.keyCode;
  // Player 1 Arrow Keys
  if(key === 37 && dir1 !== 'RIGHT') dir1 = 'LEFT';
  if(key === 38 && dir1 !== 'DOWN') dir1 = 'UP';
  if(key === 39 && dir1 !== 'LEFT') dir1 = 'RIGHT';
  if(key === 40 && dir1 !== 'UP') dir1 = 'DOWN';
  // Player 2 WASD Keys
  if(key === 65 && dir2 !== 'RIGHT') dir2 = 'LEFT'; // A
  if(key === 87 && dir2 !== 'DOWN') dir2 = 'UP'; // W
  if(key === 68 && dir2 !== 'LEFT') dir2 = 'RIGHT'; // D
  if(key === 83 && dir2 !== 'UP') dir2 = 'DOWN'; // S
});

function draw() {
  ctx.fillStyle = '#222';
  ctx.fillRect(0,0,canvas.width,canvas.height);

  // Draw food
  ctx.fillStyle = '#f00';
  ctx.fillRect(food.x, food.y, box, box);

  // Move snakes
  function moveSnake(snake, dir) {
    let head = { x: snake[0].x, y: snake[0].y };
    if(dir==='LEFT') head.x -= box;
    if(dir==='RIGHT') head.x += box;
    if(dir==='UP') head.y -= box;
    if(dir==='DOWN') head.y += box;
    snake.unshift(head);
    return head;
  }

  let head1 = moveSnake(snake1, dir1);
  let head2 = moveSnake(snake2, dir2);

  // Check food for player 1
  if(head1.x === food.x && head1.y === food.y){
    score1++;
    food = { x: Math.floor(Math.random() * 20) * box, y: Math.floor(Math.random() * 20) * box };
  } else { snake1.pop(); }

  // Check food for player 2
  if(head2.x === food.x && head2.y === food.y){
    score2++;
    food = { x: Math.floor(Math.random() * 20) * box, y: Math.floor(Math.random() * 20) * box };
  } else { snake2.pop(); }

  // Draw snakes
  snake1.forEach((segment,i)=>{
    ctx.fillStyle = i===0 ? '#0f0' : '#0a0';
    ctx.fillRect(segment.x, segment.y, box, box);
  });
  snake2.forEach((segment,i)=>{
    ctx.fillStyle = i===0 ? '#00f' : '#00a';
    ctx.fillRect(segment.x, segment.y, box, box);
  });

  // Collision detection
  function checkCollision(head, snake) {
    if(head.x < 0 || head.x >= canvas.width || head.y < 0 || head.y >= canvas.height) return true;
    for(let i=1;i<snake.length;i++){
      if(head.x===snake[i].x && head.y===snake[i].y) return true;
    }
    return false;
  }

  if(checkCollision(head1, snake1) || checkCollision(head1, snake2) || checkCollision(head2, snake2) || checkCollision(head2, snake1)){
    clearInterval(game);
    alert(`Game Over! Player 1: ${score1} | Player 2: ${score2}`);
    location.reload();
  }

  document.getElementById('scoreboard').innerText = `Player 1: ${score1} | Player 2: ${score2}`;
}

let game = setInterval(draw, speed);
</script>
</body>
</html>
