<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Snake Deluxe Pro Smooth Rotations</title>
<style>
body {
  margin: 0;
  overflow: hidden;
  font-family: Arial, sans-serif;
  background: #111;
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  flex-direction: column;
}
canvas {
  border-radius: 15px;
  box-shadow: 0 0 30px #000 inset;
  background: #222;
}
#menu, #scoreboard {
  position: absolute;
  top: 20px;
  font-size: 20px;
  text-align: center;
  width: 100%;
  z-index: 10;
}
#menu button {
  margin: 5px;
  padding: 10px 20px;
  font-size: 18px;
  cursor: pointer;
  border: none;
  border-radius: 8px;
  background: #444;
  color: #fff;
  transition: 0.2s;
}
#menu button:hover { background: #666; }
#customization { margin-top:10px; display:flex; justify-content:center; gap:10px; }
select { padding:5px; font-size:14px; }
</style>
</head>
<body>
<div id="menu">
  <div>Snake Deluxe Pro Smooth Rotations</div>
  <div id="customization">
    <label>Snake Color:
      <select id="snakeColor">
        <option value="#0f0">Green</option>
        <option value="#0ff">Cyan</option>
        <option value="#ff0">Yellow</option>
        <option value="#f0f">Magenta</option>
        <option value="#fff">White</option>
      </select>
    </label>
    <label>Snake Head:
      <select id="snakeHead">
        <option value="🐍">Snake</option>
        <option value="😎">Cool</option>
        <option value="👑">Crown</option>
        <option value="🍎">Apple</option>
        <option value="🦖">Dino</option>
      </select>
    </label>
  </div>
  <button id="startBtn">Start Game</button>
</div>
<div id="scoreboard">Score: 0</div>
<canvas id="gameCanvas" width="600" height="600"></canvas>
<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const box = 25;
let speed = 5;
let snake = [];
let dir = 'RIGHT';
let nextDir = 'RIGHT';
let food = {};
let score = 0;
let particles = [];
let game;
const snakeColorSelect = document.getElementById('snakeColor');
const snakeHeadSelect = document.getElementById('snakeHead');

document.getElementById('startBtn').addEventListener('click', () => {
  document.getElementById('menu').style.display = 'none';
  startGame();
});

document.addEventListener('keydown', e => {
  const key = e.keyCode;
  if(key === 37 && dir !== 'RIGHT') nextDir = 'LEFT';
  if(key === 38 && dir !== 'DOWN') nextDir = 'UP';
  if(key === 39 && dir !== 'LEFT') nextDir = 'RIGHT';
  if(key === 40 && dir !== 'UP') nextDir = 'DOWN';
});

function startGame(){
  snake = [{ x: 12*box, y: 12*box }];
  dir = 'RIGHT';
  nextDir = 'RIGHT';
  score = 0;
  particles = [];
  speed = 5;
  spawnFood();
  document.getElementById('scoreboard').innerText = 'Score: 0';
  if(game) cancelAnimationFrame(game);
  game = requestAnimationFrame(update);
}

function spawnFood(){
  food = { x: Math.floor(Math.random()*24)*box, y: Math.floor(Math.random()*24)*box };
}

function createParticles(x, y){
  for(let i=0;i<15;i++){
    particles.push({
      x: x + box/2,
      y: y + box/2,
      vx: (Math.random()-0.5)*2,
      vy: (Math.random()-0.5)*2,
      alpha: 1,
      size: Math.random()*4 + 2
    });
  }
}

function drawParticles(){
  for(let i=particles.length-1;i>=0;i--){
    let p = particles[i];
    ctx.fillStyle = `rgba(255,255,0,${p.alpha})`;
    ctx.fillRect(p.x,p.y,p.size,p.size);
    p.x += p.vx;
    p.y += p.vy;
    p.alpha -= 0.03;
    if(p.alpha <= 0) particles.splice(i,1);
  }
}

function drawBackground(){
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  for(let x=0;x<canvas.width;x+=box){
    ctx.beginPath();
    ctx.moveTo(x,0);
    ctx.lineTo(x,canvas.height);
    ctx.stroke();
  }
  for(let y=0;y<canvas.height;y+=box){
    ctx.beginPath();
    ctx.moveTo(0,y);
    ctx.lineTo(canvas.width,y);
    ctx.stroke();
  }
}

function drawFood(){
  const gradient = ctx.createRadialGradient(food.x + box/2, food.y + box/2, 5, food.x + box/2, food.y + box/2, box);
  gradient.addColorStop(0, '#ff5555');
  gradient.addColorStop(1, '#ff0000');
  ctx.fillStyle = gradient;
  ctx.fillRect(food.x, food.y, box, box);
}

function update(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  drawBackground();
  drawFood();
  drawParticles();

  dir = nextDir;

  // Smooth movement
  let head = { ...snake[0] };
  if(dir==='LEFT') head.x -= speed;
  if(dir==='RIGHT') head.x += speed;
  if(dir==='UP') head.y -= speed;
  if(dir==='DOWN') head.y += speed;

  // Food collision
  if(Math.abs(head.x - food.x)<speed && Math.abs(head.y - food.y)<speed){
    score++;
    document.getElementById('scoreboard').innerText = 'Score: ' + score;
    createParticles(food.x, food.y);
    spawnFood();
    if(speed < 12) speed += 0.2;
  } else snake.pop();

  snake.unshift(head);

  // Draw snake tail
  for(let i=snake.length-1;i>0;i--){
    const alpha = 1 - (i / snake.length) * 0.7;
    ctx.fillStyle = snakeColorSelect.value;
    ctx.globalAlpha = alpha;
    ctx.beginPath();
    ctx.arc(snake[i].x+box/2,snake[i].y+box/2, box/2, 0, Math.PI*2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  // Draw snake head with rotation
  const headX = snake[0].x + box/2;
  const headY = snake[0].y + box/2;
  ctx.save();
  ctx.translate(headX, headY);
  let angle = 0;
  if(dir==='LEFT') angle = Math.PI;
  if(dir==='RIGHT') angle = 0;
  if(dir==='UP') angle = -Math.PI/2;
  if(dir==='DOWN') angle = Math.PI/2;
  ctx.rotate(angle);
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.font = box + "px Arial";
  ctx.fillText(snakeHeadSelect.value, 0, 0);
  ctx.restore();

  // Collision detection
  if(head.x < 0 || head.x >= canvas.width || head.y < 0 || head.y >= canvas.height){
    gameOver();
    return;
  }
  for(let i=1;i<snake.length;i++){
    if(Math.hypot(head.x - snake[i].x, head.y - snake[i].y) < speed){
      gameOver();
      return;
    }
  }

  game = requestAnimationFrame(update);
}

function gameOver(){
  cancelAnimationFrame(game);
  alert(`Game Over! Your Score: ${score}`);
  document.getElementById('menu').style.display = 'block';
}
</script>
</body>
</html>
